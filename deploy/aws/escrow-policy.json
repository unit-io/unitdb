{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UnitdbKeyringEscrow",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:CreateSecret"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT:secret:unitdb/CLUSTER/keyring-*"
    }
  ]
}
