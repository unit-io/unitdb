{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UnitdbBackupPutOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::BUCKET/CLUSTER/*"
    }
  ]
}
